# Copy to backend/.env and fill in your values.

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the Claude model (default: claude-sonnet-4-6).
# Use claude-opus-4-8 for higher quality, or claude-haiku-4-5 for lower cost/speed.
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: reasoning effort — low | medium | high | max (default: medium).
# Lower is faster and cheaper; raise it if you want more thorough extraction.
# CLAUDE_EFFORT=medium

# Comma-separated list of allowed CORS origins for the frontend.
# Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000
